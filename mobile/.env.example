# Snaply Mobile Environment Configuration Example

# Backend Target: 'local' (development) or 'render' (production)
EXPO_PUBLIC_BACKEND_TARGET=local

# Set to true if testing on an Android Emulator (routes to 10.0.2.2:5000)
EXPO_PUBLIC_USE_EMULATOR=false

# Optional: Override local LAN IP if dynamic detection is unavailable
# EXPO_PUBLIC_LOCAL_IP=10.23.8.245

# To switch to Render production backend, set:
# EXPO_PUBLIC_BACKEND_TARGET=render
# EXPO_PUBLIC_API_URL=https://snaply-server-aogm.onrender.com
# EXPO_PUBLIC_SOCKET_URL=https://snaply-server-aogm.onrender.com
