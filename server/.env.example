# Development Atlas database: test
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/test
# Production must use the snaply-production database and a separate deployment secret.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/snaply-production
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=*
JSON_BODY_LIMIT=1mb
DEV_CHAT_SIMULATION=true
# Render production settings:
# NODE_ENV=production
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/snaply-production
# PORT=5000
# HOST=0.0.0.0
# CORS_ORIGINS=*
# DEV_CHAT_SIMULATION=true
# DEMO_REEL_URL=https://<valid-https-video-url> (optional; omit to skip the optional seeded Reel)
# SOCKET_URL=http://127.0.0.1:5000 (optional; the simulator defaults to the local server)
# Explicit production demo seed command inputs; never run automatically.
# NODE_ENV=production
# SEED_CONFIRM=SNAPLY_PRODUCTION_DEMO
# DEMO_REEL_URL=https://<cloudinary-secure-video-url>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
