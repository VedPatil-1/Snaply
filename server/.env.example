# Development Atlas database: test
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/test
# Production must use the snaply-production database and a separate deployment secret.
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/snaply-production
PORT=5000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=*
JSON_BODY_LIMIT=1mb
DEV_CHAT_SIMULATION=true
